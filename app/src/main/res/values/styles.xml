<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 统一卡片：分组容器（截图模式/设置分组/关于） -->
    <style name="Widget.PureShot.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- 可点击卡片：模式入口 -->
    <style name="Widget.PureShot.Card.Action" parent="Widget.PureShot.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- 悬浮底部导航：选中项胶囊指示器 -->
    <style name="Widget.PureShot.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PureShot.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.PureShot.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 区块标题 -->
    <style name="TextAppearance.PureShot.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- 行标题 -->
    <style name="TextAppearance.PureShot.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 行说明 -->
    <style name="TextAppearance.PureShot.RowDesc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
